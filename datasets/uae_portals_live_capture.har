            "size": 4096,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html>\n<!--[if lte IE 8]> <html lang=\"en\" class=\"ie10 ie9 ie8\"> <![endif]--><!--[if IE 9]> <html lang=\"en\" class=\"ie10 ie9\"> <![endif]--><!--[if gt IE 9]><!--><html lang=\"en\"> <!--<![endif]-->\r\n\r\n<head>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n\r\n    <!-- Author -->\r\n    <meta name=\"author\" content=\"Bloom Holdings\">\r\n\r\n    <!-- Below tag will be used for android mobile browser colors, change it to main logo color of the project -->\r\n    <meta name=\"theme-color\" content=\"#393939\">\r\n\r\n    <!-- Meta Tags for Social Media -->\r\n    <meta property=\"og:site_name\" content=\"Bloom Holding | Home to new beginnings | UAE\">\r\n    <meta property=\"og:image\" content=\"https://bloomholding.com/application/themes/bloomholding/dist/images/logo-seo.jpg\">\r\n    <meta property=\"og:title\" content=\"Developer of choice for curated premium communities | Bloom Holding\">\r\n    <meta property=\"og:description\" content=\"Curator of premium communities and a trusted partner to leading brands. Explore our developments today!\">\r\n    <meta name=\"twitter:title\" content=\"Developer of choice for curated premium communities | Bloom Holding\">\r\n    <meta name=\"twitter:image\" content=\"https://bloomholding.com/application/themes/bloomholding/dist/images/logo-seo.jpg\">\r\n    <meta name=\"twitter:description\" content=\"Curator of premium communities and a trusted partner to leading brands. Explore our developments today!\">\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\r\n    <meta name=\"msvalidate.01\" content=\"679E4E41D8357AD398590EC808929BA1\">\r\n    \n<title>Developer of choice for curated premium communities | Bloom Holding</title>\n\n<meta http-equiv=\"content-type\" content=\"text/html; charset=UTF-8\">\n<meta name=\"description\" content=\"Curator of premium