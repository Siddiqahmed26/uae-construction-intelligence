            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html><html dir=\"ltr\"><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta http-equiv=\"Pragma\" content=\"no-cache\"/><meta http-equiv=\"Expires\" content=\"0\"/><title>Abu Dhabi's Trusted Digital Real Estate  Ecosystem | ADREC</title><meta name=\"apple-itunes-app\" content=\"app-id=1607496296, app-argument=https://apps.apple.com/ae/app/dari/id1607496296\"/><meta name=\"theme-color\" content=\"#ffffff\"/><link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap\" rel=\"stylesheet\"/><style>body{font-family:Poppins,sans-serif;overflow-x:hidden;touch-action:pan-y}[dir=rtl] body{font-family:Tajawal,sans-serif}#app{position:absolute;top:0;left:0;background:#fafafa;width:100%;min-height:100%;z-index:1000;display:flex}.preloader-init{position:absolute;top:calc(50% - 65px);left:calc(50% - 65px)}@media (min-width:1280px){.MuiContainer-maxWidthLg{max-width:1272px!important}}@media (min-width:1366px){.MuiContainer-maxWidthLg{max-width:1350px!important}}@media (min-width:1500px){.MuiContainer-maxWidthLg{max-width:1470px!important}}@media screen and (max-width:600px){body{max-width:100%;overflow-x:hidden}@supports (-webkit-touch-callout:none){input{font-size:16px!important}}}#onetrust-banner-sdk{position:fixed;bottom:0;left:0;width:100%;z-index:1000}</style><script type=\"text/javascript\" async>let trialCount = 0;\n      const maxTrials = 10;\n\n      function checkCookieBannerAndAdjustMenu() {\n        const cookieBanner = document.querySelector('#onetrust-banner-sdk');\n\n        if (cookieBanner) {\n          let observer;\n\n          if ('IntersectionObserver' in window) {\n            observer = new IntersectionObserver(function(entries) {\n              entries.forEach(function(entry) {\n                const header = document.getElementsByTagName('header')[0];\n                const smartBanner = document.getElementById('smartBanner');\n                const mobileTitle = document.getElementById('mobileTitle');\n\n                if (header) {\n                  if (getComputedStyle(entry.target).display !== 'none') {\n                    const cookieBannerHeight = entry.target.offsetHeight;\n\n                    // Check for mobile screen\n                    if (window.innerWidth <= 768) {\n                      if (smartBanner) {\n                        smartBanner.style.transition = 'margin-top 0.3s ease'; // Add transition\n                        smartBanner.style.setProperty('margin-top', cookieBannerHeight + 'px', 'important');\n                      } else if (mobileTitle) {\n                        mobileTitle.style.transition = 'margin-top 0.3s ease'; // Add transition\n                        mobileTitle.style.setProperty('margin-top', cookieBannerHeight + 'px', 'important');\n                      }\n                    } else {\n                      header.style.transition = 'margin-top 0.3s ease'; // Add transition\n                      header.style.setProperty('margin-top', cookieBannerHeight + 'px', 'important');\n                    }\n                  } else {\n                    document.body.classList.remove('has-cookie-banner-open');\n                    header.style.setProperty('margin-top', 0 + 'px', 'important');\n\n                    // Reset the top property on mobile elements\n                    if (smartBanner) {\n                      smartBanner.style.transition = 'margin-top 0.3s ease'; // Add transition\n                      smartBanner.style.setProperty('margin-top', 0 + 'px', 'important');\n                    }\n                    if (mobileTitle) {\n                      mobileTitle.style.transition = 'margin-top 0.3s ease'; // Add transition\n                      mobileTitle.style.setProperty('margin-top', 0 + 'px', 'important');\n                    }\n                  }\n                }\n              });\n            });\n\n            observer.observe(cookieBanner);\n          }\n\n          d"
