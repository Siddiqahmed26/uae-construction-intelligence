            "text": " <!DOCTYPE html> <html lang=\"en\" > <head> <meta charset=\"UTF-8\"> <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"> <link rel=\"icon\" href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/images/Favicon.jpg\" type=\"image/jpeg\"> <link rel=\"preload\" as=\"font\" href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/fonts/SuisseIntl-Regular.woff\" type=\"font/woff\" crossorigin> <link rel=\"preload\" as=\"font\" href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/fonts/SuisseIntl-Regular.woff2\" type=\"font/woff2\" crossorigin> <link href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/css/bootstrap.min.css\" rel=\"stylesheet\" type=\"text/css\" /><link href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/css/swiper-bundle.min.css\" rel=\"stylesheet\" type=\"text/css\" /><link href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/css/aos.css\" rel=\"stylesheet\" type=\"text/css\" /><link href=\"/ResourcePackages/ModonCorporate/Assets/src/Assets/css/style.css\" rel=\"stylesheet\" type=\"text/css\" />  <title>\r\n\tModon Holding - Bringing Cities to Life\r\n</title> \r\n\r\n <meta name=\"facebook-domain-verification\" content=\"remzdu0ikzatcfckvkm718y5bpfu7a\" /><meta property=\"og:title\" content=\"Modon Holding - Bringing Cities to Life\" /><meta property=\"og:description\" content=\"Modon Holding is an international holding company headquartered in Abu Dhabi, United Arab Emirates, and listed on the Abu Dhabi Securities Exchange (ADX). We are at the forefront of urban innovation, creating iconic designs and experiences that consistently exceed expectations.\" /><meta property=\"og:url\" content=\"https://www.modon.com\" /><meta property=\"og:type\" content=\"website\" /><meta property=\"og:site_name\" content=\"Modon Corporate\" /><style type=\"text/css\" media=\"all\">\r\nbody:not(.sfPageEditor) .footer,\r\nbody:not(.sfPageEditor) .destination-section,\r\nbody:not(.sfPageEditor) .news-section,\r\nbody:not(.sfPageEditor) .investor-section,\r\nbody:not(.sfPageEditor) .newlaunches-section,\r\nbody:not(.sfPageEditor) .career-section,\r\nbody:not(.sfPageEditor) .helper-block{\r\n  display: none;\r\n}\r\n\r\n</style><script type=\"text/javascript\">\r\nfunction checkContentAndShowElements() {\r\n    var contentWrapper = document.querySelector(\".content-wrapper\");\r\n    if (!contentWrapper) return;\r\n\r\n    // List of elements to show when content is ready\r\n    var elementsToShow = [\r\n      document.querySelector(\".footer\"),\r\n      document.querySelector(\".destination-section\"),\r\n      document.querySelector(\".news-section\"),\r\n      document.querySelector(\".investor-section\"),\r\n      document.querySelector(\".career-section\"),\r\n      document.querySelector(\".newlaunches-section\"),\r\n      document.querySelector(\".helper-block\")\r\n    ];\r\n\r\n    // Find meaningful <div>s inside content-wrapper (excluding inside header/footer)\r\n    var innerDivs = Array.from(contentWrapper.querySelectorAll(\"div\"))\r\n      .filter(function (div) {\r\n        return !div.closest(\"footer\");\r\n      });\r\n\r\n    if (innerDivs.length > 0) {\r\n      // Delay before revealing elements\r\n      setTimeout(function () {\r\n        elementsToShow.forEach(function (el) {\r\n          if (el) el.style.display = \"block\";\r\n        });\r\n      }, 200); // Show after 1 second\r\n    } else {\r\n      // Retry every 300ms\r\n      setTimeout(checkContentAndShowElements, 150);\r\n    }\r\n  }\r\n\r\n  window.addEventListener(\"load\", checkContentAndShowElements);\r\n</script><script type=\"text/javascript\">\r\n(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBe